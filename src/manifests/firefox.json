{
  "manifest_version": 3,
  "name": "Rewind Chat",
  "version": "1.3.0",
  "description": "Ferramenta interna da Next Fit para gerar resumos de atendimentos de suporte, lendo a conversa direto da tela do Freshchat.",
  "author": "Next Fit",
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://*.freshchat.com/*", "https://*.myfreshworks.com/*", "https://*.amazonaws.com/*"],
  "background": { "scripts": ["background/index.js"] },
  "content_scripts": [{ "matches": ["https://*.myfreshworks.com/crm/messaging/*"], "js": ["content/index.js"], "css": ["styles/content.css"], "run_at": "document_idle" }],
  "action": { "default_title": "Rewind Chat" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "rewind-chat@nextfit.com.br",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
